  "bin": {
    "playbook": "reference/sdlc/code.playbook/bin/playbook.js"
  },
  "exports": {
    "./runtime": {
      "types": "./src/runtime.d.ts",
      "default": "./src/runtime.js"
    },
    "./xstate-runtime": {
      "types": "./src/xstate-runtime.d.ts",
      "default": "./src/xstate-runtime.js"
    },
    "./captain/playbook": {
      "types": "./reference/sdlc/captain.playbook/captain.playbook.d.ts",
      "default": "./reference/sdlc/captain.playbook/captain.playbook.js"
    },
    "./code/playbook": {
      "types": "./reference/sdlc/code.playbook/code.playbook.d.ts",
      "default": "./reference/sdlc/code.playbook/code.playbook.js"
    },
    "./code/registry": {
      "types": "./reference/sdlc/code.playbook/code.registry.d.ts",
      "default": "./reference/sdlc/code.playbook/code.registry.js"
    },
    "./playbook-captain": {
      "types": "./reference/sdlc/code.playbook/playbook-captain.d.ts",
      "default": "./reference/sdlc/code.playbook/playbook-captain.js"
    },
    "./session-store": {
      "types": "./reference/sdlc/code.playbook/session-store.d.ts",
      "default": "./reference/sdlc/code.playbook/session-store.js"
    },
    "./host-capabilities": {
      "types": "./reference/sdlc/code.playbook/host-capabilities.d.ts",
      "default": "./reference/sdlc/code.playbook/host-capabilities.js"
    },
    "./slc/*": "./slc/*",
    "./review/playbook": {
      "types": "./reference/sdlc/review.playbook/review.playbook.d.ts",
      "default": "./reference/sdlc/review.playbook/review.playbook.js"
    },
    "./review/registry": {
      "types": "./reference/sdlc/review.playbook/review.registry.d.ts",
      "default": "./reference/sdlc/review.playbook/review.registry.js"
    },
    "./decide/playbook": {
      "types": "./reference/sdlc/decide.playbook/decide.playbook.d.ts",
      "default": "./reference/sdlc/decide.playbook/decide.playbook.js"
    },
    "./decide/registry": {
      "types": "./reference/sdlc/decide.playbook/decide.registry.d.ts",
      "default": "./reference/sdlc/decide.playbook/decide.registry.js"
    },
    "./dev/playbook": {
      "types": "./reference/sdlc/dev.playbook/dev.playbook.d.ts",
      "default": "./reference/sdlc/dev.playbook/dev.playbook.js"
    },
    "./dev/registry": {
      "types": "./reference/sdlc/dev.playbook/dev.registry.d.ts",
      "default": "./reference/sdlc/dev.playbook/dev.registry.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "spex lint && vitest run --exclude src/cligent-release-capabilities.test.ts && vitest run src/cligent-release-capabilities.test.ts",
    "test:acceptance": "vitest run --config vitest.acceptance.config.ts",
    "smoke:release": "node scripts/release-smoke.mjs",
    "check:links": "node scripts/check-links.mjs",
    "playbook": "node reference/sdlc/code.playbook/bin/playbook.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@sublang/cligent": "^0.24.0",
    "@sublang/spex": "^3.0.0",
    "p-queue": "^9.3.1",
    "xstate": "^5.19.4",
    "yaml": "^2.9.0"
