# Optional co-development override: link @sublang/cligent to a compatible
# local checkout instead of the registry version pinned in pnpm-lock.yaml.
#
# Normal source development and production installs should not use this
# file. Copy it into place only when changing Playbook alongside cligent:
#
#   cp pnpm-workspace.yaml.example pnpm-workspace.yaml
#   # adjust the relative path to your local cligent checkout, then
#   pnpm install
#
# Adjust the path below to point at your local cligent checkout. The
# default assumes cligent sits beside this `playbook` repo:
#   <parent>/cligent
#   <parent>/playbook   <- you are here
#
# Caveat: when this file is present, `pnpm install` updates
# pnpm-lock.yaml to reference the local link instead of the
# registry-pinned cligent. The lockfile mutation is local-only — do
# not commit it. `pnpm install --frozen-lockfile` will refuse with
# ERR_PNPM_LOCKFILE_CONFIG_MISMATCH while this override is active;
# that's expected.
packages:
  - .

overrides:
  '@sublang/cligent': link:../cligent
